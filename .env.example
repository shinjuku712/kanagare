# All optional. ADMIN_EMAIL/ADMIN_PASSWORD are only read on the first start,
# while there are no users. This file holds a password, so chmod 600 it.

# Anything but "development" makes the session cookie Secure (HTTPS only).
NODE_ENV=production

# Listens on 127.0.0.1 only; put nginx or Caddy in front for HTTPS.
PORT=3463

DB_PATH=./kanagare.db

# Uploaded files. They're not in the database, so back this up too.
UPLOADS_DIR=./uploads

# Per-file limit in bytes (25 MB). Keep your proxy's body limit above it.
MAX_UPLOAD_BYTES=26214400

# Changing this signs everyone out.
COOKIE_NAME=kanagare_session

# Name and description of the app when installed (PWA).
APP_NAME=Kanagare
APP_DESCRIPTION=A small kanban board you host yourself.

ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-this-before-first-start
