{
  "name": "kanagare",
  "version": "1.0.0",
  "description": "A small self-hosted kanban board. Node + SQLite, or Cloudflare Workers.",
  "license": "MIT",
  "keywords": [
    "kanban",
    "self-hosted",
    "sqlite",
    "cloudflare-workers",
    "react",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shinjuku712/kanagare.git"
  },
  "bugs": {
    "url": "https://github.com/shinjuku712/kanagare/issues"
  },
  "homepage": "https://github.com/shinjuku712/kanagare#readme",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "NODE_ENV=development PORT=3999 node server/index.ts",
    "start": "node server/index.ts",
    "build": "vite build",
    "check": "npm run cf:types --silent && tsc -p server/tsconfig.json && tsc -p web/tsconfig.json && tsc -p worker/tsconfig.json",
    "cf:types": "wrangler types worker/worker-configuration.d.ts -c worker/wrangler.example.jsonc --include-env=false > /dev/null",
    "cf:deploy": "node scripts/cf-deploy.mjs",
    "icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "puppeteer-core": "^25.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.5",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "wrangler": "^4.143.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260926.1": true,
    "better-sqlite3@12.8.0": true
  }
}
